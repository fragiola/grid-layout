{
    "name": "@fragiola/grid-layout-react",
    "version": "0.0.0",
    "description": "Composable, unstyled React primitives for @fragiola/grid-layout: draggable, resizable grid layouts styled entirely by you.",
    "keywords": [
        "react",
        "grid",
        "layout",
        "dashboard",
        "draggable",
        "resizable",
        "headless",
        "drag-and-drop"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/grid-layout.git",
        "directory": "packages/react"
    },
    "homepage": "https://fragiola.com/grid-layout",
    "bugs": {
        "url": "https://github.com/fragiola/grid-layout/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./compactors": {
            "@fragiola/source": "./src/compactors.ts",
            "types": "./dist/compactors.d.ts",
            "import": "./dist/compactors.js",
            "default": "./dist/compactors.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./compactors": {
                "types": "./dist/compactors.d.ts",
                "import": "./dist/compactors.js",
                "default": "./dist/compactors.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/grid-layout": "workspace:*"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "jsdom": "30.1.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
