{
    "name": "@fragiola/grid-layout",
    "version": "0.0.0",
    "description": "Headless grid layout core: layout rules (collision, move, compaction), a typed model with commands, and the engine that binds a draggable, resizable grid to the DOM.",
    "keywords": [
        "grid",
        "layout",
        "dashboard",
        "draggable",
        "resizable",
        "headless",
        "drag-and-drop"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/grid-layout.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/grid-layout",
    "bugs": {
        "url": "https://github.com/fragiola/grid-layout/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./compactors": {
            "@fragiola/source": "./src/compactors/index.ts",
            "types": "./dist/compactors.d.ts",
            "import": "./dist/compactors.js",
            "default": "./dist/compactors.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./compactors": {
                "types": "./dist/compactors.d.ts",
                "import": "./dist/compactors.js",
                "default": "./dist/compactors.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "jsdom": "30.1.1",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
